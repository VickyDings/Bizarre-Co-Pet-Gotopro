{
  // Pet-GoToPro — self-hosted CMS on Cloudflare Workers
  "name": "petgotopro-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petgotopro",
      "database_id": "local-dev" // replaced with the real ID at deploy time
    }
  ],
    "rules": [
    { "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
